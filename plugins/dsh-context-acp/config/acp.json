{
  "$comment": "dsh-context-acp 的唯一人工配置源。改完跑 `node tools/gen-acp-preset.mjs --write` 重生成 preset 覆盖层与 runtime.json，再重启 DSH。",
  "backend": "acp",
  "nudge": {
    "pressureRatio": 0.65,
    "growthTokens": 12000,
    "cooldownSteps": 6,
    "maxPerTurn": 2,
    "minFreeTokens": 20000
  },
  "retain": {
    "decompressPageSize": 8,
    "searchLimit": 20,
    "searchExcerptChars": 240,
    "protectActiveUserMessage": true,
    "protectAgentInstructions": true,
    "protectSkillCatalog": true
  },
  "engine": {
    "fallbackToLlmSummary": true
  },
  "fallback": {
    "enabled": true,
    "ratio": 0.75,
    "afterUnansweredNudges": 2,
    "retryCooldownSteps": 3
  },
  "handoff": {
    "enabled": true,
    "afterCompactions": 2,
    "prefix": "HANDOFF-context-acp",
    "maxRecentUserMessages": 8,
    "refreshOnHigherCompaction": true
  }
}
