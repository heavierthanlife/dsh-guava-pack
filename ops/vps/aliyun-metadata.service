[Unit]
Description=Allow Aliyun metadata/DNS through Tailscale CGNAT drop
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/dsh-aliyun-metadata.sh
# 元数据可用后重启云助手，让它重新注册（失败不影响本单元）。
ExecStartPost=-/bin/systemctl try-restart aliyun.service

[Install]
WantedBy=multi-user.target
