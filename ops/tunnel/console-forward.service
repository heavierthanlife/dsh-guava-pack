[Unit]
# 在 PC 的 WSL 里把 VPS 上的几个 Web 入口转发到本机，绕开 Windows 侧
# 公司 VPN / 代理 / 分流规则对 100.64.0.0/10 的拦截。
#
# 转发：8090 控制台、3001 Kuma、8080 ntfy、8081 miniserve
# 用法：systemctl --user enable --now console-forward.service
#       Windows 浏览器打开 http://localhost:<端口>
Description=Forward VPS web entries (console/kuma/ntfy/miniserve) to localhost
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/dsh/tunnel.env
ExecStart=/usr/bin/ssh -F /dev/null -N \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
  -o StrictHostKeyChecking=yes \
  -L 0.0.0.0:8090:${VPS_TAILNET_IP}:8090 \
  -L 0.0.0.0:3001:${VPS_TAILNET_IP}:3001 \
  -L 0.0.0.0:8080:${VPS_TAILNET_IP}:8080 \
  -L 0.0.0.0:8081:${VPS_TAILNET_IP}:8081 \
  root@${VPS_TAILNET_IP}
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
